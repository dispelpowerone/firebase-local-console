      "title": "Ad Pipeline Funnel",
      "type": "barchart",
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "rawSql": "WITH stages AS\n  (SELECT arrayJoin([\n    (1, 'custom_ads_init_success'),\n    (2, 'custom_ads_preload'),\n    (3, 'custom_ads_banner_loaded'),\n    (4, 'custom_ads_banner_active'),\n    (5, 'custom_ads_event_loaded'),\n    (6, __ADS_INTERSTITIAL_DISPLAYED__),\n    (7, __ADS_INTERSTITIAL_CLICKED__)\n  ]) AS t)\nSELECT\n  tupleElement(t, 1) AS sort_order,\n  tupleElement(t, 2) AS step,\n  uniq(e.user_pseudo_id) AS unique_users\nFROM stages\nLEFT JOIN analytics_events e ON e.event_name = tupleElement(t, 2)\nAND e.import_dataset = '${app_dataset}'\nAND e.event_date >= toDate('${__from:date:YYYY-MM-DD}')\nAND e.event_date <= toDate('${__to:date:YYYY-MM-DD}')\nGROUP BY t\nORDER BY sort_order",
          "refId": "A",
          "format": 1
        }
      ],
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "sort_order"
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "sort_order": true
            }
          }
        }
      ]
