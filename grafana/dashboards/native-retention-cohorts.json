      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "rawSql": "SELECT\n  first_day AS time,\n  round(countIf(DISTINCT user_pseudo_id, days_since = 1) * 100.0 / count(DISTINCT user_pseudo_id), 1) AS d1_retention,\n  round(countIf(DISTINCT user_pseudo_id, days_since = 7) * 100.0 / count(DISTINCT user_pseudo_id), 1) AS d7_retention,\n  round(countIf(DISTINCT user_pseudo_id, days_since = 14) * 100.0 / count(DISTINCT user_pseudo_id), 1) AS d14_retention\nFROM (\n  SELECT\n    a.user_pseudo_id,\n    b.first_day,\n    dateDiff('day', b.first_day, a.event_date) AS days_since\n  FROM analytics_events a\n  INNER JOIN (\n    SELECT user_pseudo_id, min(event_date) AS first_day\n    FROM analytics_events\n    WHERE import_dataset = '${app_dataset}'\n    GROUP BY user_pseudo_id\n  ) b ON a.user_pseudo_id = b.user_pseudo_id\n  WHERE a.import_dataset = '${app_dataset}'\n)\nGROUP BY first_day\nORDER BY first_day",
          "refId": "A",
          "format": 1
        }
      ],
      "title": "Retention Rates (D1, D7, D14)",
      "type": "timeseries"
