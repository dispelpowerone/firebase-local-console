  "panels": [
    {
      "title": "Test Funnel Overview",
      "type": "barchart",
      "id": 1,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "barWidth": 0.8,
        "groupWidth": 0.7,
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "rawSql": "WITH stages AS (\n  SELECT arrayJoin([\n    (1, 'custom_app_loaded', 'App Loaded'),\n    (2, 'custom_tests_menu_loaded', 'Tests Menu'),\n    (3, 'custom_pre_test_loaded', 'Pre-Test Loaded'),\n    (4, 'custom_test_completed', 'Test Completed'),\n    (5, 'custom_results_screen_opened', 'Results Opened'),\n    (6, 'custom_review_page_view', 'Review Page')\n  ]) AS t\n)\nSELECT\n  tupleElement(t, 1) AS sort_order,\n  tupleElement(t, 3) AS step,\n  uniqExact(e.user_pseudo_id) AS users\nFROM stages\nLEFT JOIN analytics_events e\n  ON e.event_name = tupleElement(t, 2)\n  AND e.import_dataset = '${app_dataset}'\n  AND e.event_date >= toDate('${__from:date:YYYY-MM-DD}')\n  AND e.event_date <= toDate('${__to:date:YYYY-MM-DD}')\nGROUP BY t\nORDER BY sort_order",
          "refId": "A",
          "format": 1
        }
      ],
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [{ "field": "sort_order" }]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "sort_order": true }
          }
        }
      ]
    },
    {
      "title": "Daily Test Completions",
      "type": "timeseries",
      "id": 2,
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "rawSql": "SELECT\n  event_date AS time,\n  count() AS completions\nFROM analytics_events\nWHERE event_name = 'custom_test_completed'\n  AND import_dataset = '${app_dataset}'\n  AND event_date >= toDate('${__from:date:YYYY-MM-DD}')\n  AND event_date <= toDate('${__to:date:YYYY-MM-DD}')\nGROUP BY event_date\nORDER BY event_date",
          "refId": "A",
          "format": 1
        }
      ]
    },
    {
      "title": "Daily Tests Started",
      "type": "timeseries",
      "id": 3,
      "gridPos": {
