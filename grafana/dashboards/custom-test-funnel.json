      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "rawSql": "SELECT\n  event_date AS time,\n  countIf(event_name = 'custom_test_completed') / countIf(event_name = 'custom_pre_test_loaded') * 100 AS completion_rate\nFROM analytics_events\nWHERE event_name IN ('custom_test_completed', 'custom_pre_test_loaded')\n  AND import_dataset = '${app_dataset}'\n  AND event_date >= toDate('${__from:date:YYYY-MM-DD}')\n  AND event_date <= toDate('${__to:date:YYYY-MM-DD}')\nGROUP BY event_date\nORDER BY event_date",
          "refId": "A",
          "format": 1
        }
      ]
    },
