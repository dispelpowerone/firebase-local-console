          "rawSql": "SELECT\n  event_date AS time,\n  count() AS starts\nFROM analytics_events\nWHERE event_name = 'custom_pre_test_loaded'\n  AND import_dataset = '${app_dataset}'\n  AND event_date >= toDate('${__from:date:YYYY-MM-DD}')\n  AND event_date <= toDate('${__to:date:YYYY-MM-DD}')\nGROUP BY event_date\nORDER BY event_date",
          "refId": "A",
          "format": 1
        }
      ]
    },
    {
      "title": "Completion Rate per Day",
      "type": "timeseries",
      "id": 4,
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2,
            "pointSize": 5,
