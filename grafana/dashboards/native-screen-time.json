      "title": "Engagement Time Distribution",
      "type": "barchart",
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "rawSql": "SELECT bucket, count() AS users FROM ( SELECT user_pseudo_id, event_date, CASE WHEN sum(param_engagement_time_msec) / 1000 < 60 THEN '<1min' WHEN sum(param_engagement_time_msec) / 1000 < 300 THEN '1-5min' WHEN sum(param_engagement_time_msec) / 1000 < 900 THEN '5-15min' WHEN sum(param_engagement_time_msec) / 1000 < 1800 THEN '15-30min' WHEN sum(param_engagement_time_msec) / 1000 < 3600 THEN '30min-1h' ELSE '>1h' END AS bucket FROM analytics_events WHERE import_dataset = '${app_dataset}' AND event_date >= toDate('${__from:date:YYYY-MM-DD}') AND event_date <= toDate('${__to:date:YYYY-MM-DD}') AND event_name = 'user_engagement' AND param_engagement_time_msec > 0 GROUP BY user_pseudo_id, event_date ) GROUP BY bucket ORDER BY CASE bucket WHEN '<1min' THEN 1 WHEN '1-5min' THEN 2 WHEN '5-15min' THEN 3 WHEN '15-30min' THEN 4 WHEN '30min-1h' THEN 5 ELSE 6 END",
          "refId": "A",
          "format": 1
        }
      ]
    }
