          "rawSql": "SELECT event_date AS time, sum(param_engagement_time_msec) / uniqExact(user_pseudo_id) / 1000 AS avg_engagement_sec FROM analytics_events WHERE import_dataset = '${app_dataset}' AND event_date >= toDate('${__from:date:YYYY-MM-DD}') AND event_date <= toDate('${__to:date:YYYY-MM-DD}') AND event_name = 'user_engagement' AND param_engagement_time_msec > 0 GROUP BY event_date ORDER BY event_date",
