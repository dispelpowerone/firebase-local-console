          "rawSql": "SELECT\n  event_date,\n  uniqExactMerge(rolling_window_state) OVER (\n                                             ORDER BY event_date ASC RANGE BETWEEN 29 PRECEDING AND CURRENT ROW) AS rolling_30d_mau\nFROM\n  (SELECT\n     event_date,\n     uniqExactState(user_pseudo_id) AS rolling_window_state\n   FROM analytics_events\n   WHERE import_dataset = '${app_dataset}'\n   GROUP BY event_date)\nORDER BY event_date ASC",
