          "rawSql": "SELECT\n  event_date AS TIME,\n  uniqExact(user_pseudo_id) AS dau\nFROM analytics_events\nWHERE import_dataset = '${app_dataset}'\n  AND event_date >= toDate($__from / 1000)\n  AND event_date <= toDate($__to / 1000)\nGROUP BY event_date\nORDER BY event_date",
