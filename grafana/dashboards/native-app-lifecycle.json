    {
      "title": "Uninstall Rate",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 15
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "rawSql": "SELECT\n  uniqExact(CASE WHEN event_name = 'app_remove' THEN user_pseudo_id END) * 100.0\n  / greatest(uniqExact(user_pseudo_id), 1) AS uninstall_rate\nFROM analytics_events\nWHERE import_dataset = '${app_dataset}'\n  AND event_date >= toDate('${__from:date:YYYY-MM-DD}')\n  AND event_date <= toDate('${__to:date:YYYY-MM-DD}')",
          "refId": "A",
          "format": 1
        }
      ]
    },
    {
      "title": "Lifecycle Events Summary",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "rawSql": "SELECT\n  event_name,\n  count() AS total_events,\n  uniqExact(user_pseudo_id) AS unique_users,\n  round(count() / greatest(dateDiff('day', toDate('${__from:date:YYYY-MM-DD}'), toDate('${__to:date:YYYY-MM-DD}')) + 1, 1), 2) AS events_per_day\nFROM analytics_events\nWHERE import_dataset = '${app_dataset}'\n  AND event_name IN ('app_remove', 'app_update', 'os_update', 'app_exception', 'app_clear_data')\n  AND event_date >= toDate('${__from:date:YYYY-MM-DD}')\n  AND event_date <= toDate('${__to:date:YYYY-MM-DD}')\nGROUP BY event_name\nORDER BY total_events DESC",
          "refId": "A",
          "format": 1
        }
      ]
    }
  ],
