        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "rawSql": "SELECT\n  d.event_date AS TIME,\n  coalesce(n.new_users, 0) AS new_users,\n  d.dau - coalesce(n.new_users, 0) AS returning_users\nFROM\n  (SELECT\n     event_date,\n     uniqExact(user_pseudo_id) AS dau\n   FROM analytics_events\n   WHERE import_dataset = '${app_dataset}'\n     AND event_date >= toDate('${__from:date:YYYY-MM-DD}')\n     AND event_date <= toDate('${__to:date:YYYY-MM-DD}')\n   GROUP BY event_date) d\nLEFT JOIN\n  (SELECT\n     event_date,\n     uniqExact(user_pseudo_id) AS new_users\n   FROM analytics_events\n   WHERE import_dataset = '${app_dataset}'\n     AND event_date >= toDate('${__from:date:YYYY-MM-DD}')\n     AND event_date <= toDate('${__to:date:YYYY-MM-DD}')\n     AND event_name = 'first_open'\n   GROUP BY event_date) n ON d.event_date = n.event_date\nORDER BY d.event_date",
          "refId": "A",
          "format": 1
        }
      ],
