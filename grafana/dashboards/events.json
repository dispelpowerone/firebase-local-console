      "targets": [
        {
          "rawSql": "SELECT\n  concat(device_mobile_brand_name, ' ', device_mobile_model_name) AS device,\n  count() AS event_count\nFROM analytics_events\nWHERE import_dataset = '${app_dataset}'\n  AND event_name = '${event_name}'\n  AND event_date >= toDate($__from / 1000)\n  AND event_date <= toDate($__to / 1000)\n  AND device_mobile_brand_name IS NOT NULL\nGROUP BY device\nORDER BY event_count DESC\nLIMIT 15",
          "format": 1,
          "refId": "A",
          "queryType": "sql",
          "meta": {
            "builderOptions": {
              "mode": "list",
