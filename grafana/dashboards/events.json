            "uid": "clickhouse"
          },
          "rawSql": "SELECT\n  event_date AS time,\n  round(count() * 1.0 / cnt, 2) AS events_per_active_session\nFROM analytics_events\nINNER JOIN (\n  SELECT event_date AS day, uniqExact(user_pseudo_id, param_ga_session_id) AS cnt\n  FROM analytics_events\n  WHERE import_dataset = '${app_dataset}'\n    AND event_name = 'user_engagement'\n    AND param_engagement_time_msec > 60000\n    AND event_date >= toDate($__from / 1000)\n    AND event_date <= toDate($__to / 1000)\n  GROUP BY event_date\n) AS active ON analytics_events.event_date = active.day\nWHERE import_dataset = '${app_dataset}'\n  AND event_name = '${event_name}'\n  AND event_date >= toDate($__from / 1000)\n  AND event_date <= toDate($__to / 1000)\nGROUP BY event_date, cnt\nORDER BY event_date",
          "refId": "A",
          "format": 1
        }
      ],
      "title": "Avg Events per Active Session \u2014 $event_name",
