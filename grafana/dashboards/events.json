      "targets": [
        {
          "rawSql": "SELECT\n  event_date AS time,\n  count() AS event_count\nFROM analytics_events\nWHERE import_dataset = '${app_dataset}'\n  AND event_name = '${event_name}'\n  AND event_date >= toDate($__from / 1000)\n  AND event_date <= toDate($__to / 1000)\nGROUP BY event_date\nORDER BY event_date",
          "format": 1,
          "refId": "A",
          "queryType": "sql",
          "meta": {
            "builderOptions": {
              "mode": "list",
              "fields": [],
              "limit": 1000
