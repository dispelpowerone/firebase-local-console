          },
          "queryType": "sql",
          "rawSql": "SELECT\n  dataset,\n  event_date,\n  created_at,\n  completed_at,\n  'pending' AS status\nFROM import_tasks FINAL\nWHERE completed_at IS NULL\n\nUNION ALL\n\nSELECT\n  dataset,\n  event_date,\n  created_at,\n  completed_at,\n  'completed' AS status\nFROM\n(\n  SELECT dataset, event_date, created_at, completed_at\n  FROM import_tasks FINAL\n  WHERE completed_at IS NOT NULL\n  ORDER BY completed_at DESC\n  LIMIT 5\n)\n\nORDER BY status DESC, event_date DESC",
          "refId": "A"
        }
      ],
      "title": "Import Status",
      "type": "table"
