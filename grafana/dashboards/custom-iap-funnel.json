      "title": "IAP Funnel",
      "type": "barchart",
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "rawSql": "WITH stages AS\n  (SELECT arrayJoin([\n    (1, 'custom_iap_init_successful'),\n    (2, 'custom_iap_purchase_request'),\n    (3, 'in_app_purchase'),\n    (4, 'custom_premium_activated_opened'),\n    (5, 'custom_iap_init_failed'),\n    (6, 'custom_iap_purchase_failed')\n  ]) AS t)\nSELECT\n  tupleElement(t, 1) AS sort_order,\n  tupleElement(t, 2) AS step,\n  uniq(e.user_pseudo_id) AS unique_users\nFROM stages\nLEFT JOIN analytics_events e ON e.event_name = tupleElement(t, 2)\nAND e.import_dataset = '${app_dataset}'\nAND e.event_date >= toDate('${__from:date:YYYY-MM-DD}')\nAND e.event_date <= toDate('${__to:date:YYYY-MM-DD}')\nGROUP BY t\nORDER BY sort_order",
          "refId": "A",
          "format": 1
        }
      ],
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "sort_order"
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "sort_order": true
            }
          }
        }
      ]
    },
