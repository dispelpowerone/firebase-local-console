      "title": "IAP Events Timeline",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "rawSql": "SELECT\n  event_date AS TIME,\n  countIf(event_name = 'custom_iap_init_successful') AS iap_init_successful,\n  countIf(event_name = 'custom_iap_purchase_request') AS iap_purchase_request,\n  countIf(event_name = 'in_app_purchase') AS in_app_purchase,\n  countIf(event_name = 'custom_iap_purchase_failed') AS iap_purchase_failed\nFROM analytics_events\nWHERE import_dataset = '${app_dataset}'\n  AND event_name IN (\n                       'custom_iap_init_successful',\n                       'custom_iap_purchase_request',\n                       'in_app_purchase',\n                       'custom_iap_purchase_failed')\n  AND event_date >= toDate('${__from:date:YYYY-MM-DD}')\n  AND event_date <= toDate('${__to:date:YYYY-MM-DD}')\nGROUP BY event_date\nORDER BY event_date",
          "refId": "A",
          "format": 1
        }
      ]
