          "rawSql": "WITH stages AS\n  (SELECT arrayJoin([\n    (1, 'custom_iap_restore_request'),\n    (2, 'custom_iap_restore_successful'),\n    (3, 'custom_iap_restore_not_found'),\n    (4, 'custom_iap_restore_not_available')\n  ]) AS t)\nSELECT\n  tupleElement(t, 1) AS sort_order,\n  tupleElement(t, 2) AS step,\n  count(e.event_name) AS EVENTS\nFROM stages\nLEFT JOIN analytics_events e ON e.event_name = tupleElement(t, 2)\nAND e.import_dataset = '${app_dataset}'\nAND e.event_date >= toDate('${__from:date:YYYY-MM-DD}')\nAND e.event_date <= toDate('${__to:date:YYYY-MM-DD}')\nGROUP BY t\nORDER BY sort_order",
