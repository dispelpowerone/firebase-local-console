      "title": "IAP Funnel",
      "type": "barchart",
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "rawSql": "SELECT event_name AS step, uniq(user_pseudo_id) AS unique_users FROM analytics_events WHERE import_dataset = '${app_dataset}' AND event_name IN ('custom_iap_init_successful', 'custom_iap_purchase_request', 'in_app_purchase', 'custom_premium_activated_opened', 'custom_iap_init_failed', 'custom_iap_purchase_failed') AND event_date >= toDate('${__from:date:YYYY-MM-DD}') AND event_date <= toDate('${__to:date:YYYY-MM-DD}') GROUP BY event_name ORDER BY CASE event_name WHEN 'custom_iap_init_successful' THEN 1 WHEN 'custom_iap_purchase_request' THEN 2 WHEN 'in_app_purchase' THEN 3 WHEN 'custom_premium_activated_opened' THEN 4 WHEN 'custom_iap_init_failed' THEN 5 WHEN 'custom_iap_purchase_failed' THEN 6 END",
          "refId": "A",
          "format": 1
        }
      ]
    },
