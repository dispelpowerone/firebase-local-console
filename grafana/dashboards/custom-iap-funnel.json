          "rawSql": "SELECT event_date AS time, countIf(event_name = 'custom_iap_init_successful') AS iap_init_successful, countIf(event_name = 'custom_iap_purchase_request') AS iap_purchase_request, countIf(event_name = 'in_app_purchase') AS in_app_purchase, countIf(event_name = 'custom_iap_purchase_failed') AS iap_purchase_failed FROM analytics_events WHERE import_dataset = '${app_dataset}' AND event_name IN ('custom_iap_init_successful', 'custom_iap_purchase_request', 'in_app_purchase', 'custom_iap_purchase_failed') AND event_date >= toDate('${__from:date:YYYY-MM-DD}') AND event_date <= toDate('${__to:date:YYYY-MM-DD}') GROUP BY event_date ORDER BY event_date",
          "refId": "A",
          "format": 1
