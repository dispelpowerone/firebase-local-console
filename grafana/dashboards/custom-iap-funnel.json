      "title": "Purchase Request to Success Rate",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "rawSql": "SELECT if(request_count = 0, 0, round(purchase_count / request_count * 100, 2)) AS success_rate\nFROM\n\n  (SELECT count(*) AS request_count\n   FROM analytics_events\n   WHERE import_dataset = '${app_dataset}'\n     AND event_name = 'custom_iap_purchase_request'\n     AND event_date >= toDate('${__from:date:YYYY-MM-DD}')\n     AND event_date <= toDate('${__to:date:YYYY-MM-DD}')) AS a,\n\n  (SELECT count(*) AS purchase_count\n   FROM analytics_events\n   WHERE import_dataset = '${app_dataset}'\n     AND event_name = 'in_app_purchase'\n     AND event_date >= toDate('${__from:date:YYYY-MM-DD}')\n     AND event_date <= toDate('${__to:date:YYYY-MM-DD}')) AS b",
