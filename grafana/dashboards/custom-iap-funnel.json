      "title": "Conversion Rate",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "rawSql": "SELECT if(init_users = 0, 0, round(purchase_users / init_users * 100, 2)) AS conversion_rate\nFROM\n\n  (SELECT uniq(user_pseudo_id) AS init_users\n   FROM analytics_events\n   WHERE import_dataset = '${app_dataset}'\n     AND event_name = 'custom_iap_init_successful'\n     AND event_date >= toDate('${__from:date:YYYY-MM-DD}')\n     AND event_date <= toDate('${__to:date:YYYY-MM-DD}')) AS a,\n\n  (SELECT uniq(user_pseudo_id) AS purchase_users\n   FROM analytics_events\n   WHERE import_dataset = '${app_dataset}'\n     AND event_name = 'in_app_purchase'\n     AND event_date >= toDate('${__from:date:YYYY-MM-DD}')\n     AND event_date <= toDate('${__to:date:YYYY-MM-DD}')) AS b",
          "refId": "A",
