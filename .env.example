# GCP / BigQuery
# Credentials are configured per-app in config/config.yaml
# Service account JSON files go in the credentials/ directory

# Database type: clickhouse or duckdb
DB_TYPE=clickhouse

# ClickHouse connection (used when DB_TYPE=clickhouse)
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_DATABASE=firebase
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# DuckDB (used when DB_TYPE=duckdb)
DUCKDB_PATH=/data/firebase.duckdb

# Import schedule (interval in hours)
IMPORT_INTERVAL_HOURS=6

# Grafana
GF_SECURITY_ADMIN_PASSWORD=admin
