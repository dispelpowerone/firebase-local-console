# GCP / BigQuery
# Credentials are configured per-app in config/config.yaml
# Service account JSON files go in the credentials/ directory

# ClickHouse connection
CLICKHOUSE_DATABASE=firebase
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Import schedule (interval in hours)
IMPORT_INTERVAL_HOURS=6

# Grafana
GF_SECURITY_ADMIN_PASSWORD=admin
